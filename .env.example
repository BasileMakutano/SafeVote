# Copy to .env and edit. Never commit .env.
# Generate a key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
# Local development (lvh.me and all its subdomains resolve to 127.0.0.1):
SERVER_NAME=lvh.me:5000
PREFERRED_URL_SCHEME=http
# Production example:
# SERVER_NAME=safevote.example.com
# PREFERRED_URL_SCHEME=https
# TRUSTED_PROXY=1
DATABASE_PATH=instance/safevote.db
TIMEZONE=Africa/Nairobi
# Optional: only allow registration emails from one domain
# ALLOWED_EMAIL_DOMAIN=strathmore.edu
